# Normalize to LF in the repository. Without this, files authored on Windows
# land in the Linux container with CRLF, which breaks shebangs, shell scripts
# and Docker entrypoints at runtime.
* text=auto eol=lf

# Files that must be LF regardless of platform.
*.sh          text eol=lf
*.py          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.toml        text eol=lf
*.tf          text eol=lf
*.sql         text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.json        text eol=lf
*.md          text eol=lf
Dockerfile    text eol=lf
.dockerignore text eol=lf
.gitignore    text eol=lf

# Binary assets - never touch.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.onnx binary

# =============================================================================
# DraftForge backend configuration
#
# Copy to .env and fill in real values. Never commit the resulting .env.
# Settings marked REQUIRED have no default and the app will refuse to start
# without them.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="DraftForge"
APP_VERSION="1.0.0"
ENVIRONMENT="development"          # development | staging | production
DEBUG=True                         # must be False when ENVIRONMENT=production
HOST="0.0.0.0"
PORT=8000

# Exact allowed browser origins, comma-separated. No wildcards: credentialed
# CORS requires exact origins. Localhost origins are added automatically
# outside production, and never in production.
ALLOWED_ORIGINS=""

# Accepted Host header values, comma-separated. Must be explicit in production.
TRUSTED_HOSTS="*"

# Interactive API docs at /docs and /redoc. Forced off in production.
ENABLE_DOCS=True

# Public URL of the frontend; used to build invitation links.
APP_PUBLIC_URL="http://localhost:5173"

# -----------------------------------------------------------------------------
# Supabase  (REQUIRED)
# -----------------------------------------------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
# Bypasses row-level security. Never expose to the browser or any client.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
# Used to verify HS256 tokens when the project does not publish a JWKS.
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

SUPABASE_REFERENCE_BUCKET="reference-documents"
SUPABASE_DRAFT_BUCKET="student-drafts"
SUPABASE_SUBMISSION_BUCKET="assignment-submissions"

# -----------------------------------------------------------------------------
# JWT verification
# Tokens are verified locally against the project JWKS or shared secret, so
# there is no per-request round-trip to Supabase Auth.
# -----------------------------------------------------------------------------
JWT_AUDIENCE="authenticated"
JWT_LEEWAY_SECONDS=30
JWKS_CACHE_TTL_SECONDS=600
JWKS_REFRESH_COOLDOWN_SECONDS=30
JWKS_REQUEST_TIMEOUT_SECONDS=5.0

# -----------------------------------------------------------------------------
# Neo4j Aura  (REQUIRED)
# -----------------------------------------------------------------------------
NEO4J_URI="neo4j+s://your-db-id.databases.neo4j.io"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="your-strong-password"
NEO4J_DATABASE="neo4j"

# -----------------------------------------------------------------------------
# Qdrant Cloud  (REQUIRED)
# -----------------------------------------------------------------------------
QDRANT_URL="https://your-cluster-id.qdrant.tech:6333"
QDRANT_API_KEY="your-qdrant-api-key"
QDRANT_COLLECTION_NAME="legal_reference_corpus"

# -----------------------------------------------------------------------------
# LLM & embeddings
# -----------------------------------------------------------------------------
LLM_PROVIDER="groq"
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="llama-3.3-70b-versatile"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="mistral:latest"

EMBEDDING_PROVIDER="fastembed"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

# Outbound budgets. Without these a hung upstream ties up a worker forever.
LLM_REQUEST_TIMEOUT_SECONDS=45.0
VECTOR_REQUEST_TIMEOUT_SECONDS=10.0
GRAPH_REQUEST_TIMEOUT_SECONDS=10.0

# -----------------------------------------------------------------------------
# Redis - rate limiting, caching, email outbox
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"
# When False, rate limiting fails open if Redis is unreachable (dev only).
# Must be True in production.
REDIS_REQUIRED=False

RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_AUTH_PER_HOUR=30
RATE_LIMIT_LLM_PER_MINUTE=10
RATE_LIMIT_LLM_PER_DAY=300
RATE_LIMIT_UPLOAD_PER_HOUR=40
RATE_LIMIT_INVITE_PER_HOUR=200

# Per-user daily LLM token allowance. 0 disables the budget check.
LLM_TOKEN_BUDGET_PER_DAY=150000

# -----------------------------------------------------------------------------
# Request hardening
# -----------------------------------------------------------------------------
MAX_REQUEST_BYTES=20971520
MAX_UPLOAD_BYTES=15728640
HSTS_MAX_AGE_SECONDS=63072000

# -----------------------------------------------------------------------------
# Email - student invitations (Resend)
# -----------------------------------------------------------------------------
# "console" prints emails to stdout for local development.
# Must be a real provider in production.
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
RESEND_API_URL="https://api.resend.com/emails"
EMAIL_FROM_ADDRESS="DraftForge <onboarding@draftforge.app>"
EMAIL_REPLY_TO=""
EMAIL_REQUEST_TIMEOUT_SECONDS=15.0
EMAIL_MAX_RETRIES=5

INVITE_TOKEN_TTL_HOURS=168

# -----------------------------------------------------------------------------
# Observability - OpenTelemetry over OTLP to Grafana Cloud
# -----------------------------------------------------------------------------
OTEL_ENABLED=False
OTEL_SERVICE_NAME="draftforge-api"
OTEL_EXPORTER_OTLP_ENDPOINT=""
# e.g. "Authorization=Basic <base64 instanceID:token>"
OTEL_EXPORTER_OTLP_HEADERS=""
OTEL_TRACES_SAMPLER_RATIO=1.0

LOG_FORMAT="console"               # console | json  (use json in deployed envs)
LOG_LEVEL="INFO"

{
  "uid": "draftforge-rag-evaluation",
  "title": "DraftForge · Retrieval & Evaluation Quality",
  "description": "Retrieval quality degrades silently — nothing errors, answers just get worse. These panels are the signal that catches it before a student reports a bad answer.",
  "tags": ["draftforge", "rag", "quality"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-12h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "prometheus" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Retrieval quality",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Median top score",
      "description": "Best similarity score per query. A sustained fall means indexing or the embedding model has regressed. Alerts below 0.45.",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.45 },
              { "color": "green", "value": 0.6 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(draftforge_rag_top_score_bucket[30m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Median results returned",
      "description": "Zero here means the collection is empty, unreachable, or over-filtered.",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "green", "value": 3 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(draftforge_rag_results_bucket[15m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Retrieval p95",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 3, "color": { "mode": "fixed", "fixedColor": "blue" } }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(draftforge_rag_duration_bucket[5m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Evaluations (24h)",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "purple" } }
      },
      "targets": [
        { "expr": "sum(increase(draftforge_evaluations_total[24h]))", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Top score over time, by document type",
      "description": "Split by type because a regression often affects one rubric's corpus rather than all of them.",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(draftforge_rag_top_score_bucket[30m])) by (le, rag_document_type))",
          "legendFormat": "{{rag_document_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Retrieval latency percentiles",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 5, "showPoints": "never" }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(draftforge_rag_duration_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(draftforge_rag_duration_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "title": "Deterministic evaluation",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },
    {
      "type": "timeseries",
      "title": "Score distribution by document type",
      "description": "The scorer is deterministic, so a shift in this distribution means the rubric, the corpus or the cohort changed — never run-to-run variance.",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 100,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(draftforge_evaluation_score_bucket[1h])) by (le, evaluation_document_type))",
          "legendFormat": "median · {{evaluation_document_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Evaluation latency by document type",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(draftforge_evaluation_duration_bucket[5m])) by (le, evaluation_document_type))",
          "legendFormat": "p95 · {{evaluation_document_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Onboarding",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }
    },
    {
      "type": "timeseries",
      "title": "Invitation outcomes",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 15, "stacking": { "mode": "normal" }, "showPoints": "never" }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(draftforge_invitations_total[15m])) by (invitation_outcome)",
          "legendFormat": "{{invitation_outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Email delivery",
      "description": "A student cannot join without their invitation, so failures here block onboarding outright.",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 15, "stacking": { "mode": "normal" }, "showPoints": "never" }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(draftforge_emails_total[15m])) by (email_status)",
          "legendFormat": "{{email_status}}",
          "refId": "A"
        }
      ]
    }
  ]
}
